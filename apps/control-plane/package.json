{
  "name": "@dadieng/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "db:migrate": "tsx src/migrate.ts",
    "retention:purge": "tsx src/retention.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/start.ts"
  },
  "dependencies": {
    "@dadieng/contracts-client": "workspace:*",
    "@dadieng/defense-module": "workspace:*",
    "@dadieng/receipt-sanitizer": "workspace:*",
    "@dadieng/replay-engine": "workspace:*",
    "@dadieng/schemas": "workspace:*",
    "pg": "^8.23.0",
    "viem": "^2.38.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5"
  }
}
