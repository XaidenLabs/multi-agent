{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/console", "destination": "/index.html" },
    { "source": "/commander", "destination": "/index.html" },
    { "source": "/proof", "destination": "/index.html" }
  ]
}
