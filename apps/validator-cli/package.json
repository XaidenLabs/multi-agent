{
  "name": "@dadieng/validator-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dadieng-validator": "./bin/dadieng-validator.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@dadieng/contracts-client": "workspace:*",
    "@dadieng/defense-module": "workspace:*",
    "@dadieng/replay-engine": "workspace:*",
    "@dadieng/schemas": "workspace:*",
    "tsx": "^4.20.5",
    "viem": "^2.38.6",
    "zod": "^4.1.5"
  }
}
